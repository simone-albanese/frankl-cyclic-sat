# STATE/hardware.env — budget di risorse misurati sulla macchina reale.
# Generato al bootstrap: 2026-08-11 13:31 CEST. Formato CHIAVE=valore (sourceable).
# Uso:  source STATE/hardware.env   poi  "$PY" script.py ...

# ---- macchina rilevata ----
CHIP="Apple M4"
MACOS=15.6.1
NCPU_LOGICI=10
PCORE=4
ECORE=6
RAM_GB=16
DISK_FREE_GB=334

# ---- budget derivati (regola 6 di CLAUDE.md) ----
RAM_JOB_MAX_GB=9              # 60% di 16 GB, arrotondato per difetto
CORES_JOB=3                   # P-core - 1
DISK_MIN_FREE_GB=10
TIMEOUT_DEFAULT_MIN=20        # escalation x3 UNA sola volta (=60 min) e solo
                              # se il run interrotto mostrava progresso misurabile
TIMEOUT_ESCALATION_MIN=60

# ---- interprete Python del progetto (NON usare "python3" nudo) ----
# In shell non interattiva "python3" e' Python 3.14 di Homebrew, SENZA ortools
# ne' pysat: usare sempre "$PY" o il path relativo .venv/bin/python3.
PY=/Users/simonealbanese/Documents/Matematics/frankl/.venv/bin/python3
PYVER=3.13.12
ORTOOLS=9.15.6755
PYSAT=1.9.dev13
